  "fixed_sql": [
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "connections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"connections\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"host\" TEXT NOT NULL, \"port\" INTEGER NOT NULL DEFAULT 22, \"username\" TEXT NOT NULL, \"identity_ids\" TEXT NOT NULL DEFAULT '[]', \"save_password\" INTEGER NOT NULL DEFAULT 0 CHECK (\"save_password\" IN (0, 1)), \"jump_host_id\" TEXT NULL REFERENCES connections (id) ON DELETE SET NULL, \"group_name\" TEXT NULL, \"color\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"keep_alive_seconds\" INTEGER NOT NULL DEFAULT 15, \"last_used_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "identities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"identities\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"algorithm\" TEXT NOT NULL, \"bits\" INTEGER NOT NULL, \"public_key\" TEXT NOT NULL, \"fingerprint\" TEXT NOT NULL, \"encrypted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"encrypted\" IN (0, 1)), \"require_biometric\" INTEGER NOT NULL DEFAULT 0 CHECK (\"require_biometric\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "known_hosts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"known_hosts\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"host\" TEXT NOT NULL, \"port\" INTEGER NOT NULL, \"key_type\" TEXT NOT NULL, \"fingerprint\" TEXT NOT NULL, \"last_seen_at\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"host\", \"port\", \"key_type\"));"
        }
      ]
    },
    {
      "name": "bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarks\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"connection_id\" TEXT NOT NULL REFERENCES connections (id) ON DELETE CASCADE, \"path\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "forward_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"forward_rules\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"connection_id\" TEXT NOT NULL REFERENCES connections (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"label\" TEXT NOT NULL DEFAULT '', \"bind_host\" TEXT NOT NULL DEFAULT '127.0.0.1', \"bind_port\" INTEGER NOT NULL, \"target_host\" TEXT NOT NULL DEFAULT '', \"target_port\" INTEGER NOT NULL DEFAULT 0, \"auto_start\" INTEGER NOT NULL DEFAULT 0 CHECK (\"auto_start\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
